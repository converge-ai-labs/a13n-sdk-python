{
  "components": {
    "schemas": {
      "ToolSearchGroup": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/BuiltinToolsetKey"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "connections": {
            "default": [],
            "items": {
              "maxLength": 41,
              "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
              "type": "string"
            },
            "maxItems": 128,
            "title": "Connections",
            "type": "array"
          },
          "description": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "platform": {
            "default": false,
            "title": "Platform",
            "type": "boolean"
          },
          "plugins": {
            "default": [],
            "items": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "maxItems": 128,
            "title": "Plugins",
            "type": "array"
          }
        },
        "required": [
          "description"
        ],
        "title": "ToolSearchGroup",
        "type": "object"
      },
      "BuiltinToolsetKey": {
        "enum": [
          "files",
          "shell",
          "computer",
          "browser",
          "web",
          "memory",
          "assets"
        ],
        "type": "string"
      },
      "ToolSearchConfig": {
        "additionalProperties": false,
        "description": "Names and bounded discovery settings for one Agent's proxy surface.",
        "properties": {
          "call_name": {
            "default": "call_tool",
            "title": "Call Name",
            "type": "string"
          },
          "describe_name": {
            "default": "describe_tool",
            "title": "Describe Name",
            "type": "string"
          },
          "groups_name": {
            "default": "list_tool_groups",
            "title": "Groups Name",
            "type": "string"
          },
          "list_name": {
            "default": "list_tools",
            "title": "List Name",
            "type": "string"
          },
          "max_results": {
            "default": 10,
            "title": "Max Results",
            "type": "integer"
          },
          "max_search_bytes": {
            "default": 32768,
            "title": "Max Search Bytes",
            "type": "integer"
          },
          "mode": {
            "const": "proxy",
            "default": "proxy",
            "title": "Mode",
            "type": "string"
          },
          "search_name": {
            "default": "discover_tools",
            "title": "Search Name",
            "type": "string"
          }
        },
        "title": "ProxyToolSearchConfig",
        "type": "object"
      },
      "ToolSearch": {
        "additionalProperties": false,
        "description": "Presentation of already-selected sources, composed by Harness once per agent.",
        "properties": {
          "automatic": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AutomaticToolSearch"
              },
              {
                "type": "null"
              }
            ]
          },
          "config": {
            "$ref": "#/components/schemas/ToolSearchConfig"
          },
          "groups": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ToolSearchGroup"
            },
            "maxProperties": 128,
            "title": "Groups",
            "type": "object"
          }
        },
        "title": "ToolSearch",
        "type": "object"
      },
      "AutomaticToolSearch": {
        "additionalProperties": false,
        "description": "Group Service-owned sources individually, following the agent's selections.",
        "properties": {
          "capabilities": {
            "default": [
              "browser",
              "computer"
            ],
            "items": {
              "$ref": "#/components/schemas/BuiltinToolsetKey"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "connections": {
            "default": true,
            "title": "Connections",
            "type": "boolean"
          },
          "exclude_connections": {
            "default": [],
            "items": {
              "maxLength": 41,
              "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
              "type": "string"
            },
            "maxItems": 128,
            "title": "Exclude Connections",
            "type": "array"
          },
          "exclude_platform": {
            "default": false,
            "title": "Exclude Platform",
            "type": "boolean"
          }
        },
        "title": "AutomaticToolSearch",
        "type": "object"
      },
      "Pending": {
        "additionalProperties": false,
        "description": "Public projection; complete native requests and private metadata stay in the checkpoint.",
        "properties": {
          "approvals": {
            "items": {
              "$ref": "#/components/schemas/PendingCall"
            },
            "title": "Approvals",
            "type": "array"
          },
          "calls": {
            "items": {
              "$ref": "#/components/schemas/PendingCall"
            },
            "title": "Calls",
            "type": "array"
          }
        },
        "required": [
          "approvals",
          "calls"
        ],
        "title": "Pending",
        "type": "object"
      },
      "PendingCall": {
        "additionalProperties": false,
        "properties": {
          "arguments": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Arguments",
            "type": "object"
          },
          "presentation": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Presentation"
          },
          "tool_call_id": {
            "$ref": "#/components/schemas/ToolCallId"
          },
          "tool_name": {
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "tool_call_id",
          "tool_name",
          "arguments"
        ],
        "title": "PendingCall",
        "type": "object"
      },
      "ToolCallId": {
        "maxLength": 1024,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "JsonValue": {},
      "HistoricalDesktopPending": {
        "additionalProperties": false,
        "description": "Read-only projection of sealed desktop suspensions predating Computer-scoped control.",
        "properties": {
          "approvals": {
            "items": {
              "$ref": "#/components/schemas/PendingCall"
            },
            "title": "Approvals",
            "type": "array"
          },
          "calls": {
            "items": {
              "$ref": "#/components/schemas/PendingCall"
            },
            "title": "Calls",
            "type": "array"
          },
          "desktop_control_id": {
            "title": "Desktop Control Id",
            "type": "string"
          }
        },
        "required": [
          "approvals",
          "calls",
          "desktop_control_id"
        ],
        "title": "HistoricalDesktopPending",
        "type": "object"
      },
      "Control": {
        "properties": {
          "control": {
            "enum": [
              "automation",
              "draining",
              "human",
              "returning"
            ],
            "title": "Control",
            "type": "string"
          },
          "controller_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Controller Id"
          },
          "controller_thread_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Controller Thread Id"
          },
          "episode": {
            "title": "Episode",
            "type": "integer"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "failure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure"
          },
          "generation": {
            "title": "Generation",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "generation",
          "episode",
          "control",
          "controller_id",
          "controller_thread_id",
          "expires_at",
          "failure"
        ],
        "title": "Control",
        "type": "object"
      },
      "ContextUsage": {
        "description": "A Run's configured window and its latest eligible generation, when available.",
        "properties": {
          "context_window_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Window Tokens"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "record_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record Id"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "record_id",
          "input_tokens",
          "output_tokens",
          "context_window_tokens"
        ],
        "title": "ContextUsage",
        "type": "object"
      }
    }
  }
}
