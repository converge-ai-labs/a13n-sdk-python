{
  "components": {
    "schemas": {
      "View": {
        "properties": {
          "cause": {
            "enum": [
              "agent",
              "user"
            ],
            "title": "Cause",
            "type": "string"
          },
          "controller_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Controller Id"
          },
          "deadline": {
            "format": "date-time",
            "title": "Deadline",
            "type": "string"
          },
          "environment_id": {
            "title": "Environment Id",
            "type": "string"
          },
          "epoch": {
            "title": "Epoch",
            "type": "integer"
          },
          "failure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "lease_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lease Expires At"
          },
          "mount": {
            "title": "Mount",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "tool_call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Call Id"
          }
        },
        "required": [
          "id",
          "run_id",
          "tool_call_id",
          "cause",
          "environment_id",
          "mount",
          "reason",
          "state",
          "epoch",
          "controller_id",
          "deadline",
          "lease_expires_at",
          "failure",
          "outcome"
        ],
        "title": "View",
        "type": "object"
      },
      "ToolSearchGroup": {
        "additionalProperties": false,
        "properties": {
          "connections": {
            "default": [],
            "items": {
              "maxLength": 41,
              "pattern": "^[a-z][a-z0-9]{1,7}_[0-9a-f]{20,32}$",
              "type": "string"
            },
            "maxItems": 128,
            "title": "Connections",
            "type": "array"
          },
          "description": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "platform": {
            "default": false,
            "title": "Platform",
            "type": "boolean"
          },
          "plugins": {
            "default": [],
            "items": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            "maxItems": 128,
            "title": "Plugins",
            "type": "array"
          }
        },
        "required": [
          "description"
        ],
        "title": "ToolSearchGroup",
        "type": "object"
      },
      "ToolSearch": {
        "additionalProperties": false,
        "description": "Presentation of already-selected sources, composed by Harness once per agent.",
        "properties": {
          "config": {
            "$ref": "#/components/schemas/ToolSearchConfig"
          },
          "groups": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ToolSearchGroup"
            },
            "maxProperties": 128,
            "title": "Groups",
            "type": "object"
          }
        },
        "title": "ToolSearch",
        "type": "object"
      },
      "ToolSearchConfig": {
        "discriminator": {
          "mapping": {
            "native": "#/components/schemas/NativeToolSearchConfig",
            "proxy": "#/components/schemas/ProxyToolSearchConfig"
          },
          "propertyName": "mode"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/ProxyToolSearchConfig"
          },
          {
            "$ref": "#/components/schemas/NativeToolSearchConfig"
          }
        ]
      },
      "NativeToolSearchConfig": {
        "additionalProperties": false,
        "description": "Provider-native discovery; omitted strategy uses the provider default.",
        "properties": {
          "mode": {
            "const": "native",
            "default": "native",
            "title": "Mode",
            "type": "string"
          },
          "strategy": {
            "anyOf": [
              {
                "enum": [
                  "bm25",
                  "regex"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy"
          }
        },
        "required": [
          "mode"
        ],
        "title": "NativeToolSearchConfig",
        "type": "object"
      },
      "ProxyToolSearchConfig": {
        "additionalProperties": false,
        "description": "Names and bounded discovery settings for one Agent's proxy surface.",
        "properties": {
          "call_name": {
            "default": "call_proxy_tool",
            "title": "Call Name",
            "type": "string"
          },
          "max_results": {
            "default": 10,
            "title": "Max Results",
            "type": "integer"
          },
          "max_search_bytes": {
            "default": 32768,
            "title": "Max Search Bytes",
            "type": "integer"
          },
          "mode": {
            "const": "proxy",
            "default": "proxy",
            "title": "Mode",
            "type": "string"
          },
          "search_name": {
            "default": "search_proxy_tools",
            "title": "Search Name",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "ProxyToolSearchConfig",
        "type": "object"
      },
      "Request": {
        "additionalProperties": false,
        "properties": {
          "mount": {
            "maxLength": 63,
            "minLength": 1,
            "title": "Mount",
            "type": "string"
          },
          "reason": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "mount",
          "reason"
        ],
        "title": "Request",
        "type": "object"
      },
      "Control": {
        "additionalProperties": false,
        "properties": {
          "epoch": {
            "minimum": 0.0,
            "title": "Epoch",
            "type": "integer"
          },
          "session_id": {
            "pattern": "^[a-zA-Z0-9_-]{20,72}$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "epoch"
        ],
        "title": "Control",
        "type": "object"
      },
      "ContextUsage": {
        "description": "A Run's configured window and its latest eligible generation, when available.",
        "properties": {
          "context_window_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Window Tokens"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "record_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record Id"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "record_id",
          "input_tokens",
          "output_tokens",
          "context_window_tokens"
        ],
        "title": "ContextUsage",
        "type": "object"
      },
      "Completion": {
        "additionalProperties": false,
        "properties": {
          "epoch": {
            "minimum": 0.0,
            "title": "Epoch",
            "type": "integer"
          },
          "note": {
            "default": "",
            "maxLength": 2048,
            "title": "Note",
            "type": "string"
          },
          "outcome": {
            "default": "completed",
            "enum": [
              "completed",
              "abandoned"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "session_id": {
            "pattern": "^[a-zA-Z0-9_-]{20,72}$",
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "epoch"
        ],
        "title": "Completion",
        "type": "object"
      },
      "Access": {
        "properties": {
          "assistance": {
            "$ref": "#/components/schemas/View"
          },
          "expires_in_seconds": {
            "title": "Expires In Seconds",
            "type": "number"
          },
          "mode": {
            "enum": [
              "view",
              "control"
            ],
            "title": "Mode",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "websocket_url": {
            "title": "Websocket Url",
            "type": "string"
          }
        },
        "required": [
          "assistance",
          "mode",
          "websocket_url",
          "password",
          "expires_in_seconds"
        ],
        "title": "Access",
        "type": "object"
      }
    }
  }
}
